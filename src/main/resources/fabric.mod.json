{
	"schemaVersion": 1,
	"id": "power_and_cost",
	"version": "${version}",
	"name": "Power and Cost",
	"description": "Power-level-based anvil economy: material and enchantment power values drive repair durability and enchant/combine costs via sigmoid curves.",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/power_and_cost/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"power_and_cost.PowerAndCost"
		],
		"client": [
			"power_and_cost.PowerAndCostClient"
		]
	},
	"mixins": [
		"power_and_cost.mixins.json",
		{
			"config": "power_and_cost.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
